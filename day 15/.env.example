# Generate privately: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
DAY15_TOKEN=replace-with-a-random-token-at-least-32-characters
DAY15_HOST=127.0.0.1
DAY15_PORT=8787
OLLAMA_MODEL=qwen2.5-coder:7b
UPSTREAM_URL=http://127.0.0.1:11434/v1/chat/completions
DAY15_RUNNER_IMAGE=day15-runner:v2
DAY15_JOB_SECONDS=600
DAY15_TOOL_STEPS=2
# Cloud is unavailable until both model and a dedicated key are configured.
DAY15_CLOUD_URL=https://api.openai.com/v1/chat/completions
DAY15_CLOUD_MODEL=
DAY15_CLOUD_API_KEY=
DAY15_CLOUD_TOKEN_FIELD=max_completion_tokens
DAY15_CLOUD_DAILY_RUNS=5
# For OpenRouter: URL=https://openrouter.ai/api/v1/chat/completions,
# MODEL=provider/model, TOKEN_FIELD=max_tokens. Key stays in this private file.
