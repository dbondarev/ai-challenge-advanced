        "server_preview": "\"use strict\";\n\nconst http = require(\"node:http\");\nconst { URL } = require(\"node:url\");\n\nconst PORT = Number(process.env.PORT || 18080);\nconst VERSION = \"1.0.0\";\n\nfunction sendJson(res, status, body) {\n  const payload = JSON.stringify(body);\n  res.writeHead(status, {\n    \"Content-Type\": \"application/json; charset=utf-8\",\n    \"Content-Length\": Buffer.byteLength(payload),\n  });\n  res.end(payload);\n}\n\nfunction handler(req, res) {\n  const url = new URL(req.url || \"/\", \"http://localhost\");\n  const path = url.pathname;\n\n  if (req.method === \"GET\" && path === \"/health\") {\n    return sendJson(res, 200, { ok: true });\n  }\n  if (req.method === \"GET\" && path === \"/api/version\") {\n    return sendJson(res, 200, { version: VERSION });\n  }\n  if (req.method === \"GET\" && path === \"/api/echo\") {\n    const q = url.searchParams.get(\"q\") || \"\";\n    if (!q || q.length > 200) {\n      return sendJson(res, 400, { error: \"q too long\" });\n    }\n    return sendJson(res, 200, { q });\n  }\n  if (req.method === \"GET\" && path === \"/api/quote\") {\n    const sku = url.searchParams.get(\"sku\") || \"\";\n    const qty = url.searchParams.get(\"qty\") || \"\";\n\n    if (sku !== \"book\") {\n      return sendJson(res, 400, { error: \"unknown SKU\" });\n    }\n\n    if (!/^[0-9]+$/.test(qty) || parseInt(qty) < 1 || parseInt(qty) > 10) {\n      return sendJson(res, 400, { error: \"invalid quantity\" });\n    }\n\n    const total_cents = parseInt(qty) * 1000;\n    return sendJson(res, 200, { sku, qty: parseInt(qty), total_cents });\n  }\n  return sendJson(res, 404, { error: \"not found\" });\n}\n\nconst server = http.createServer(handler);\n\nif (require.main === module) {\n  server.listen(PORT, \"0.0.0.0\", () => {\n    process.stdout.write(`day15-mini-shop listening on ${PORT}\\n`);\n  });\n}\n\nmodule.exports = { handler, VERSION };\n"
