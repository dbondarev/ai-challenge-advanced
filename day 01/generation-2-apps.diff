+test("GET /books filters by author", async () => {
+  const austenEpub = await makeEpub("Emma", "Jane Austen");
+  const austenResponse = await app.inject({
+    method: "POST",
+    url: "/books",
+    headers: {
+      "content-type": "multipart/form-data; boundary=bound",
+    },
+    payload: Buffer.concat([
+      Buffer.from(
+        "--bound\r\nContent-Disposition: form-data; name=\"file\"; filename=\"book.epub\"\r\nContent-Type: application/epub+zip\r\n\r\n",
+      ),
+      austenEpub,
+      Buffer.from("\r\n--bound--\r\n"),
+    ]),
+  });
+  assert.equal(austenResponse.statusCode, 201);
+  const austen = austenResponse.json() as { id: string };
+
+  const otherEpub = await makeEpub("Moby-Dick", "Herman Melville");
+  const otherResponse = await app.inject({
+    method: "POST",
+    url: "/books",
+    headers: {
+      "content-type": "multipart/form-data; boundary=bound",
+    },
+    payload: Buffer.concat([
+      Buffer.from(
+        "--bound\r\nContent-Disposition: form-data; name=\"file\"; filename=\"book.epub\"\r\nContent-Type: application/epub+zip\r\n\r\n",
+      ),
+      otherEpub,
+      Buffer.from("\r\n--bound--\r\n"),
+    ]),
+  });
+  assert.equal(otherResponse.statusCode, 201);
+  const other = otherResponse.json() as { id: string };
+
+  const list = await app.inject({ method: "GET", url: "/books?q=Austen" });
+  assert.equal(list.statusCode, 200);
+  const ids = (list.json() as { id: string }[]).map((book) => book.id);
+  assert.equal(ids.includes(austen.id), true);
+  assert.equal(ids.includes(other.id), false);
+});
